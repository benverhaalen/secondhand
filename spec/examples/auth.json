{
  "examples": [
    {
      "name": "auth.apple", "endpoint": "POST /v1/auth/apple", "path": "/v1/auth/apple", "auth": "none", "proposed": true,
      "request": { "headers": { "Idempotency-Key": "idk_apple_01" }, "body": { "identity_token": "<apple identity token>", "nonce": "n0nce-4f1", "name": "Sam" } },
      "status": 200,
      "response": {
        "access_token": "<access token>", "refresh_token": "<refresh token>", "expires_at": "2026-11-15T04:10:00Z", "created": true,
        "user": { "id": "usr_8f2k", "auth_methods": [{ "provider": "apple", "linked_at": "2026-11-15T03:10:00Z" }], "onboarding": { "done_steps": [], "finished_at": null } }
      }
    },
    {
      "name": "auth.google", "endpoint": "POST /v1/auth/google", "path": "/v1/auth/google", "auth": "none", "proposed": true,
      "request": { "headers": { "Idempotency-Key": "idk_google_01" }, "body": { "id_token": "<google id token>" } },
      "status": 200,
      "response": {
        "access_token": "<access token>", "refresh_token": "<refresh token>", "expires_at": "2026-11-15T04:10:00Z", "created": false,
        "user": { "id": "usr_8f2k", "auth_methods": [{ "provider": "google", "linked_at": "2026-11-12T18:02:00Z" }], "onboarding": { "done_steps": ["signed_in", "sites_picked"], "finished_at": null } }
      }
    },
    {
      "name": "auth.email.start", "endpoint": "POST /v1/auth/email/start", "path": "/v1/auth/email/start", "auth": "none", "proposed": true,
      "request": { "headers": { "Idempotency-Key": "idk_email_01" }, "body": { "email": "sam@example.com" } },
      "status": 202,
      "response": { "sent": true, "expires_at": "2026-11-15T03:20:00Z", "resend_after_s": 30 }
    },
    {
      "name": "auth.email.verify", "endpoint": "POST /v1/auth/email/verify", "path": "/v1/auth/email/verify", "auth": "none", "proposed": true,
      "request": { "headers": { "Idempotency-Key": "idk_email_02" }, "body": { "email": "sam@example.com", "code": "481920" } },
      "status": 200,
      "response": {
        "access_token": "<access token>", "refresh_token": "<refresh token>", "expires_at": "2026-11-15T04:10:00Z", "created": true,
        "user": { "id": "usr_8f2k", "auth_methods": [{ "provider": "email", "linked_at": "2026-11-15T03:10:00Z" }], "onboarding": { "done_steps": [], "finished_at": null } }
      }
    },
    {
      "name": "auth.email.verify.wrong_code", "endpoint": "POST /v1/auth/email/verify", "path": "/v1/auth/email/verify", "auth": "none", "proposed": true,
      "request": { "headers": { "Idempotency-Key": "idk_email_03" }, "body": { "email": "sam@example.com", "code": "000000" } },
      "status": 401,
      "response": { "code": "unauthenticated", "message": "code does not match or expired", "failed_step": "verify_code", "retry": { "by": "user" } }
    },
    {
      "name": "auth.refresh", "endpoint": "POST /v1/auth/refresh", "path": "/v1/auth/refresh", "auth": "none", "proposed": true,
      "request": { "headers": { "Idempotency-Key": "idk_refresh_01" }, "body": { "refresh_token": "<refresh token>" } },
      "status": 200,
      "response": { "access_token": "<access token>", "refresh_token": "<new refresh token>", "expires_at": "2026-11-15T05:10:00Z" }
    },
    {
      "name": "auth.signout", "endpoint": "POST /v1/auth/signout", "path": "/v1/auth/signout",
      "request": { "headers": { "Idempotency-Key": "idk_signout_01" }, "body": { "refresh_token": "<refresh token>" } },
      "status": 204, "response": null, "proposed": true
    },
    {
      "name": "auth.link.apple", "endpoint": "POST /v1/auth/link/apple", "path": "/v1/auth/link/apple", "proposed": true,
      "request": { "headers": { "Idempotency-Key": "idk_link_01" }, "body": { "identity_token": "<apple identity token>", "nonce": "n0nce-77a" } },
      "status": 200,
      "response": { "auth_methods": [{ "provider": "google", "linked_at": "2026-11-12T18:02:00Z" }, { "provider": "apple", "linked_at": "2026-11-15T03:40:00Z" }] }
    },
    {
      "name": "auth.link.google", "endpoint": "POST /v1/auth/link/google", "path": "/v1/auth/link/google", "proposed": true,
      "request": { "headers": { "Idempotency-Key": "idk_link_02" }, "body": { "id_token": "<google id token>" } },
      "status": 200,
      "response": { "auth_methods": [{ "provider": "apple", "linked_at": "2026-11-15T03:10:00Z" }, { "provider": "google", "linked_at": "2026-11-15T03:41:00Z" }] }
    },
    {
      "name": "auth.link.email", "endpoint": "POST /v1/auth/link/email", "path": "/v1/auth/link/email", "proposed": true,
      "request": { "headers": { "Idempotency-Key": "idk_link_03" }, "body": { "email": "sam@example.com", "code": "481920" } },
      "status": 200,
      "response": { "auth_methods": [{ "provider": "apple", "linked_at": "2026-11-15T03:10:00Z" }, { "provider": "email", "linked_at": "2026-11-15T03:42:00Z" }] }
    }
  ]
}
