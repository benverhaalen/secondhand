event: message
data: {"result":{"tools":[{"name":"search_catalog","description":"[trimmed]","inputSchema":{"type":"object"}},{"name":"lookup_catalog","description":"[trimmed]","inputSchema":{"type":"object"}},{"name":"get_product","description":"[trimmed]","inputSchema":{"type":"object"}},{"name":"search_products_by_text","description":"Search for products using text description or keywords. This tool searches through various shopping platforms to find products matching your query.","inputSchema":{"type":"object","properties":{"query":{"type":"string","description":"Text query to search for products. Use the user's exact input with only spelling/grammar corrections. Do not modify the query in any way. Do not add attributes, price ranges, or features."},"refresh":{"type":"boolean","description":"Force refresh to bypass cache and get latest results."},"search_category":{"type":"string","enum":["all","Fashion","Furniture","Home Decor","Electronics","Beauty","Toys","Sporting","Pets","Baby & Kids","Auto","Food","Hardware","Office","Media","Other"],"description":"Categorize the user's search intent into one of the following categories."}},"required":["query","refresh","search_category"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":true},"execution":{"taskSupport":"forbidden"}},{"name":"search_products_by_image","description":"[trimmed]","inputSchema":{"type":"object"}},{"name":"search_products_by_url","description":"[trimmed]","inputSchema":{"type":"object"}},{"name":"get_product_details","description":"[trimmed]","inputSchema":{"type":"object"}}]},"jsonrpc":"2.0","id":2}

