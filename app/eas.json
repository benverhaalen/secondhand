{
  "cli": {
    "version": ">= 16.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview-sim": {
      "ios": {
        "simulator": true
      },
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_ORIGIN": "http://localhost:8081"
      }
    },
    "production-sim": {
      "ios": {
        "simulator": true
      },
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6835141866"
      }
    }
  }
}
