
# font files: shipped with the app at build time, never committed (public repo)
fonts/
*.otf
*.ttf
*.woff
*.woff2
# the open-licensed fallback pair (OFL, each with its OFL.txt) is committed on purpose
!app/assets/fonts-open/**/*.ttf
!web/public/fonts-open/*.ttf
# a stylesheet that names where the font files are on one machine
fonts.local.css

# raw logs and agent scratch stay on the machine that made them (log/README.md)
logs/
*.log
.harness/
__pycache__/
*.pyc

# local state of the Databricks skills installer
.databricks/
brand/explore/web-home/boards/*/out/*.html
scripts/out/

# local Python env, local browser profiles, a build worker's own report
.venv/
.browser-scratch/
WORKER_REPORT.md

# Keys and credentials never belong in this public repo.
*.p8
*.pem
*.p12
*.mobileprovision
AuthKey_*
.env
.env.*
!.env.example
*storage-state*.json
bench/out/

# Vercel link for the web/ deploy
.vercel

# Written by scripts/app-check.mjs on a full run; regenerated, never committed (its inline colors fail the token check).
features/app/gallery.html
