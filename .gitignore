
# font files: shipped with the app at build time, never committed (public repo)
fonts/
*.otf
*.ttf
*.woff
*.woff2
# a stylesheet that names where the font files are on one machine
fonts.local.css

# raw logs and agent scratch stay on the machine that made them (log/README.md)
logs/
*.log
.harness/
__pycache__/
*.pyc

# local state of the Databricks skills installer
.databricks/
brand/explore/web-home/boards/*/out/*.html

# local Python env, local browser profiles, a build worker's own report
.venv/
.browser-scratch/
WORKER_REPORT.md
