{
  "datasets": [
    {
      "name": "why",
      "displayName": "The sales behind one price",
      "queryLines": [
        "WITH pick AS (\n",
        "  SELECT g.id, g.value_cents, t.title, t.price_cents AS sold_cents\n",
        "  FROM secondhand.core.guarded_number g\n",
        "  JOIN secondhand.market.comp t ON t.comp_id = g.item_id\n",
        "  WHERE g.metric = 'valuation.model.q50' AND g.state = 'shown' AND g.data = 'dataset:stockx_2019'\n",
        "  ORDER BY g.id\n",
        "  LIMIT 12\n",
        ")\n",
        "SELECT concat(replace(p.title, '-', ' '), ': our price $', format_number(p.value_cents / 100, 0), ', sold for $', format_number(p.sold_cents / 100, 0)) AS price,\n",
        "       replace(b.title, '-', ' ') AS basis_title, w.basis_price_cents / 100.0 AS basis_price, b.at AS basis_at,\n",
        "       w.source_url, CASE WHEN w.equal THEN 'Yes' WHEN w.equal IS NULL THEN 'Not checked' ELSE 'No' END AS rebuilt\n",
        "FROM pick p, LATERAL why(p.id) w\n",
        "LEFT JOIN secondhand.market.comp b ON b.comp_id = w.basis_id\n",
        "ORDER BY price, basis_at DESC\n"
      ]
    },
    {
      "name": "proof",
      "displayName": "Citations and rebuilds",
      "queryLines": [
        "SELECT c.cited, format_number(c.shown, 0) AS shown_label,\n",
        "       r.equal_cases, format_number(r.cases, 0) AS cases_label\n",
        "FROM (SELECT sum(shown_with_citation) AS cited, sum(shown_numbers) AS shown FROM citation_coverage WHERE data <> 'synthetic') c\n",
        "CROSS JOIN (SELECT count_if(equal) AS equal_cases, count(*) AS cases FROM recompute_check) r\n"
      ]
    },
    {
      "name": "price",
      "displayName": "Price accuracy, from the metric view",
      "queryLines": [
        "WITH m AS (\n",
        "  SELECT `Price from` AS price_from, MEASURE(`Within 20 percent`) AS within_20,\n",
        "         MEASURE(`Range held the sale`) AS range_held, MEASURE(`Estimates shown`) AS shown\n",
        "  FROM valuation_metrics\n",
        "  GROUP BY ALL\n",
        ")\n",
        "SELECT max(CASE WHEN price_from = 'Our price' THEN within_20 END) AS ours,\n",
        "       max(CASE WHEN price_from = 'Last sale' THEN within_20 END) AS last_sale,\n",
        "       max(CASE WHEN price_from = '90-day median' THEN within_20 END) AS median_90,\n",
        "       max(CASE WHEN price_from = 'Our price' THEN range_held END) AS ours_range,\n",
        "       format_number(max(CASE WHEN price_from = 'Our price' THEN shown END), 0) AS ours_shown,\n",
        "       format_number(max(CASE WHEN price_from = 'Last sale' THEN shown END), 0) AS last_shown,\n",
        "       format_number(max(CASE WHEN price_from = '90-day median' THEN shown END), 0) AS median_shown\n",
        "FROM m\n"
      ]
    },
    {
      "name": "price_week",
      "displayName": "Price accuracy by week, from the metric view",
      "queryLines": [
        "SELECT `Price from` AS price_from, `Week` AS week,\n",
        "       MEASURE(`Within 20 percent`) AS within_20, MEASURE(`Estimates shown`) AS shown\n",
        "FROM valuation_metrics\n",
        "GROUP BY ALL\n",
        "ORDER BY week\n"
      ]
    },
    {
      "name": "weight",
      "displayName": "The half-life in force each month",
      "queryLines": [
        "WITH m AS (\n",
        "  SELECT * FROM param_moves\n",
        "  WHERE run_id = (SELECT max_by(run_id, month) FROM param_moves)\n",
        "), v AS (\n",
        "  SELECT version, first(value) AS value FROM m WHERE action = 'propose' GROUP BY version\n",
        "), months AS (\n",
        "  SELECT month, max(champion_version) AS champion,\n",
        "         count_if(action = 'promote' AND version > 1) AS changed,\n",
        "         count_if(action = 'hold') AS held, count_if(action = 'rollback') AS rolled_back\n",
        "  FROM m GROUP BY month\n",
        ")\n",
        "SELECT o.month, v.value AS half_life_days, o.changed, o.held, o.rolled_back\n",
        "FROM months o JOIN v ON v.version = o.champion\n",
        "UNION ALL\n",
        "SELECT add_months(min(m.month), -1), first(v.value), 0, 0, 0\n",
        "FROM m JOIN v ON v.version = 1\n",
        "ORDER BY month\n"
      ]
    },
    {
      "name": "weight_change",
      "displayName": "Each change and its evidence",
      "queryLines": [
        "WITH m AS (\n",
        "  SELECT * FROM param_moves\n",
        "  WHERE run_id = (SELECT max_by(run_id, month) FROM param_moves)\n",
        "), v AS (\n",
        "  SELECT version, first(value) AS value FROM m WHERE action = 'propose' GROUP BY version\n",
        ")\n",
        "SELECT date_format(c.month, 'MMM yyyy') AS month, f.value AS from_days, c.value AS to_days,\n",
        "       c.diff AS gain, c.noise,\n",
        "       CASE c.action WHEN 'promote' THEN 'Changed' ELSE 'Rolled back' END AS what\n",
        "FROM m c\n",
        "LEFT JOIN v f ON f.version = c.version - 1\n",
        "WHERE (c.action = 'promote' AND c.version > 1) OR c.action = 'rollback'\n",
        "ORDER BY c.month\n"
      ]
    },
    {
      "name": "guard",
      "displayName": "Rule check across every owner",
      "queryLines": [
        "SELECT violations_now, date_format(last_checked_at, 'MMM d, h:mm a') AS checked_label\n",
        "FROM guard_status\n"
      ]
    },
    {
      "name": "isolation",
      "displayName": "Locks in force",
      "queryLines": [
        "SELECT concat(schema_name, '.', table_name) AS table_label,\n",
        "       CASE WHEN has_owner_tag THEN 'Yes' ELSE 'No' END AS locked,\n",
        "       CASE WHEN has_owner_tag THEN 1 ELSE 0 END AS locked_count,\n",
        "       coalesce(nullif(array_join(masked_columns, ', '), ''), 'None') AS masked,\n",
        "       replace(retention_class, '_', ' ') AS kept_for\n",
        "FROM policies_in_force\n",
        "ORDER BY schema_name, table_name\n"
      ]
    },
    {
      "name": "reach",
      "displayName": "Owners the viewer can read",
      "queryLines": [
        "SELECT count(*) AS people_readable, format_number((SELECT count(*) FROM policies_in_force), 0) AS tables_label,\n",
        "       (SELECT count_if(has_owner_tag) FROM policies_in_force) AS locked\n",
        "FROM secondhand.governance.principal_map\n",
        "WHERE principal = current_user() AND user_id NOT IN ('system', 'usr_backtest')\n"
      ]
    },
    {
      "name": "never",
      "displayName": "Actions never taken alone",
      "queryLines": [
        "SELECT CASE kind WHEN 'move_off_site' THEN 'Move a deal off the site'\n",
        "                 WHEN 'refund' THEN 'Send a refund'\n",
        "                 WHEN 'payment' THEN 'Take or send a payment'\n",
        "                 WHEN 'complete_purchase' THEN 'Complete a purchase'\n",
        "                 ELSE replace(kind, '_', ' ') END AS action_label,\n",
        "       count(*) AS asked, count_if(NOT allow) AS refused\n",
        "FROM never_automated\n",
        "GROUP BY 1\n",
        "ORDER BY 1\n"
      ]
    },
    {
      "name": "never_total",
      "displayName": "Never-alone requests refused",
      "queryLines": [
        "SELECT count_if(NOT allow) AS refused, format_number(count(*), 0) AS asked_label\n",
        "FROM never_automated\n"
      ]
    },
    {
      "name": "sources",
      "displayName": "Where the sales come from",
      "queryLines": [
        "SELECT replace(source, '_', ' ') AS source, kept, modelled, first_at, last_at\n",
        "FROM pipeline_funnel\n",
        "ORDER BY kept DESC\n"
      ]
    }
  ],
